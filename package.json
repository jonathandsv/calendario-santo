{
  "name": "santo-do-dia",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && npm run test:scripts",
    "lint": "ng lint",
    "dados": "node scripts/gerar-dados.mjs",
    "prestart": "npm run dados",
    "prebuild": "npm run dados",
    "pretest": "npm run dados",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "postbuild": "node scripts/pos-build.mjs && node scripts/verificar-build.mjs",
    "servir": "node scripts/servir.mjs",
    "e2e": "playwright test",
    "verificar": "npm run build && npm test && npm run lint && npm run e2e",
    "imagens": "node scripts/buscar-imagens.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
